{
  "name": "groupbet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,indexer -c cyan,magenta \"next dev\" \"npm run indexer\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "fund": "node --conditions=react-server --import tsx scripts/fund-wallet.ts",
    "smoke": "node --conditions=react-server --import tsx scripts/smoke-chain.ts",
    "describe": "node --conditions=react-server --import tsx scripts/describe-image.ts",
    "indexer": "npm --prefix indexer start -- --out ./data/events.jsonl --checkpoint ./data/checkpoint.json"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.42.0",
    "@solana-program/memo": "^0.13.1",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@stripe/stripe-js": "^7.10.0",
    "bs58": "^6.0.0",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
