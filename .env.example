# Privy — SMS login + Solana embedded wallets
# https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# MongoDB — durable users / groups / markets (required for Vercel)
# Atlas free tier: https://cloud.mongodb.com
MONGODB_URI=
# MONGODB_DB=greekbet

# World ID — Selfie Check (Beta) via IDKit
# https://developer.world.org  ·  https://docs.world.org/world-id/credentials/11
# Request Selfie Check access: developers@toolsforhumanity.com
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
# Server-only RP signing key from Developer Portal (never NEXT_PUBLIC_*)
WORLD_RP_SIGNING_KEY=
# production | staging | sandbox (sandbox for World Sandbox App testing)
NEXT_PUBLIC_WORLD_ENVIRONMENT=sandbox
# true = always stub; false = require live keys; unset = stub when keys missing
# WORLD_SELFIE_CHECK_STUB=true

# Telegram bot — event DMs after members tap Start (optional)
# https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# OpenAI — describes resolution photos and validates the description (dev uses stubs if unset)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-5.6-terra
# OPENAI_VALIDATOR_MODEL=gpt-5.6-terra

# Resolver auto-resolves only when validator confidence is at least this (0..1)
# RESOLVER_AUTO_CONFIDENCE=0.85

# Optional: dedicated Solana RPC (defaults to public devnet)
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# 6-decimal collateral mint (from `npm run fund` → .data/collateral-mint.json)
# NEXT_PUBLIC_COLLATERAL_MINT=
