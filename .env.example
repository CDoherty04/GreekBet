# Privy — SMS login + Solana embedded wallets
# https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Agent / Bazantic API — Bearer or X-Api-Key for /api/agent/*
# Generate a long random string; required for agent routes + OpenAPI gateway
AGENT_API_KEY=

# MongoDB — durable users / groups / markets / chain_events (required for Vercel)
# Atlas free tier: https://cloud.mongodb.com
# Run `npm run indexer` on a long-lived host with the same MONGODB_URI so prod
# can read indexed program events from the chain_events collection.
MONGODB_URI=
# MONGODB_DB=groupbet

# Telegram bot — event DMs after members tap Start (optional)
# https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# OpenAI — describes resolution photos and validates the description (dev uses stubs if unset)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-5.6-terra
# OPENAI_VALIDATOR_MODEL=gpt-5.6-terra

# Resolver auto-resolves only when validator confidence is at least this (0..1)
# RESOLVER_AUTO_CONFIDENCE=0.85

# Optional: dedicated Solana RPC (defaults to public devnet)
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# 6-decimal collateral mint (from `npm run fund` → .data/collateral-mint.json)
# NEXT_PUBLIC_COLLATERAL_MINT=

# Deployed GroupBet program (devnet)
# NEXT_PUBLIC_GROUPBET_PROGRAM_ID=5YoHVvLTG5hxe2DoDvazNyFZkhLysrm9p6nbySyMYi5t

# Server role keys — required on Vercel (JSON byte arrays from .data/keypairs.json)
# GREEKBET_RESOLVER_SECRET=[1,2,3,...]
# GREEKBET_FEE_PAYER_SECRET=[1,2,3,...]