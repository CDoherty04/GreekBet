# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SECRET KEY MATERIAL — never commit.
# `src/lib/chain/wallet.ts` writes each user's Solana keypair here, plus the
# resolver and fee-payer keys. Committing this hands over every wallet the app
# custodies. Devnet only, but the habit is what matters.
/.data/
*keypair*.json

# Indexer runtime state: the event stream and its checkpoint are machine-local,
# and committing them would replay stale events into whatever consumes them.
/indexer/data/
