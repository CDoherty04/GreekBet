{
  "name": "greekbet-indexer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Listens to the GreekBet Anchor program and emits parsed, deduplicated, slot-ordered events. Persistence is deliberately out of scope — this produces a stream, a separate writer consumes it.",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "greekbet-indexer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "./node_modules/.bin/ts-node src/cli.ts",
    "test": "NODE_OPTIONS=--no-experimental-strip-types ts-mocha -p ./tsconfig.json -t 120000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "mocha": "^9.2.2",
    "ts-mocha": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
